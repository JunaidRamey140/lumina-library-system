{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the library system with a specific role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "librarian", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Book": {
      "title": "Book",
      "description": "A book in the library inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "isbn": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "totalCopies": { "type": "integer" },
        "availableCopies": { "type": "integer" },
        "coverUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "totalCopies", "availableCopies"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A record of a book issuance or return.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "bookTitle": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "issueDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "returnDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["issued", "returned", "overdue"] }
      },
      "required": ["bookId", "userId", "issueDate", "dueDate", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "read"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "books/{bookId}": {
      "schema": "Book",
      "description": "Library book catalog."
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Historical and active book loan transactions."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System and personalized notifications."
    }
  }
}
